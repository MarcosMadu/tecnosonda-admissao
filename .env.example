# ===== Backend (Render) =====
PORT=3000

# Banco de dados (MongoDB Atlas) — NÃO alterar o cluster/base existente
MONGO_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/tecnosonda_admissao

# Autenticação
JWT_SECRET=troque_por_uma_chave_forte_e_aleatoria

# Cloudinary (armazenamento de arquivos) — manter a conta/credenciais atuais
CLOUDINARY_CLOUD_NAME=seu_cloud_name
CLOUDINARY_API_KEY=sua_api_key
CLOUDINARY_API_SECRET=sua_api_secret

# Admin inicial (criado só na primeira execução, se não existir nenhum)
ADMIN_INITIAL_EMAIL=admin@tecnosonda.com.br
ADMIN_INITIAL_PASSWORD=Tecnosonda@2025
ADMIN_INITIAL_NAME=Administrador RH

# URL pública do FRONTEND (Vercel). O backend usa isso para gerar os
# links individuais de admissão enviados pelo RH.
# Ex.: https://tecnosonda-admissao.vercel.app
APP_URL=https://SEU-FRONTEND.vercel.app

# CORS: origens extras autorizadas, separadas por vírgula.
# *.vercel.app (produção e previews) e localhost já são aceitos por padrão.
# Use aqui apenas se tiver um domínio próprio para o frontend.
# Ex.: https://admissao.tecnosonda.com.br
CORS_ORIGINS=
