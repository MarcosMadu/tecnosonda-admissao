{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/pages/index.html" },
    { "source": "/admin/login", "destination": "/pages/admin-login.html" },
    { "source": "/admin/dashboard", "destination": "/pages/admin-dashboard.html" },
    { "source": "/admin/talentos", "destination": "/pages/admin-talentos.html" },
    { "source": "/admissao/:token", "destination": "/pages/admissao.html" },
    { "source": "/vagas", "destination": "/pages/vagas.html" }
  ]
}
